# ProofHire Backend Environment Variables
PROJECT_NAME="ProofHire AI Resume Intelligence"

# Database Connection (PostgreSQL in production, SQLite in local dev)
DATABASE_URL=postgresql://postgres:password@localhost:5432/proofhire

# Security & Authentication
JWT_SECRET=replace-with-a-strong-random-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://proofhire.vercel.app

# Private File Storage
STORAGE_DIR=./storage/resumes
MAX_UPLOAD_SIZE_MB=10

# Server Port
PORT=8000
